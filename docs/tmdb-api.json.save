                    "/3/keyword/{keyword_id}/movies": {
                        "get": {
                            "summary": "Movies",
                            "description": "",
                            "operationId": "keyword-movies",
                            "parameters": [
                                {
                                    "name": "keyword_id",
                                    "in": "path",
                                    "schema": {
                                        "type": "string"
                                    },
                                    "required": true
                                },
                                {
                                    "name": "include_adult",
                                    "in": "query",
                                    "schema": {
