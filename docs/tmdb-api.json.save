                    "/3/movie/{movie_id}/rating": {
                        "post": {
                            "summary": "Add Rating",
                            "description": "Rate a movie and save it to your rated list.",
                            "operationId": "movie-add-rating",
                            "parameters": [
                                {
                                    "name": "movie_id",
                                    "in": "path",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32"
                                    },
                                    "required": true
                                },
                                {
                                    "name": "guest_session_id",
                                    "in": "query",
                                    "schema": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "name": "session_id",
                                    "in": "query",
                                    "schema": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "name": "Content-Type",
                                    "in": "header",
                                    "required": true,
                                    "schema": {
                                        "type": "string",
                                        "default": "application/json;charset=utf-8"
                                    }
                                }
                            ],
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "required": [
                                                "RAW_BODY"
                                            ],
                                            "properties": {
                                                "RAW_BODY": {
                                                    "type": "string",
                                                    "format": "json"
                                                }
                                            }
                                        },
                                        "examples": {
                                            "Request Example": {
                                                "value": {
                                                    "value": 8.5
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "200",
                                    "content": {
                                        "application/json": {
