                    "/3/list/{list_id}/add_item": {
                        "post": {
                            "summary": "Add Movie",
                            "description": "Add a movie to a list.",
                            "operationId": "list-add-movie",
                            "parameters": [
                                {
                                    "name": "list_id",
                                    "in": "path",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32"
                                    },
                                    "required": true
                                },
                                {
                                    "name": "session_id",
                                    "in": "query",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "RAW_BODY": {
                                                    "type": "string",
                                                    "format": "json"
                                                }
                                            }
                                        },
                                        "examples": {
                                            "Request Example": {
                                                "value": {
                                                    "media_id": 18
