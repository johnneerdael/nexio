                                },
                                {
                                    "name": "primary_release_year",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32"
                                    }
                                },
                                {
                                    "name": "primary_release_date.gte",
                                    "in": "query",
                                    "schema": {
                                        "type": "string",
                                        "format": "date"
