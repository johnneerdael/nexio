                    "/3/configuration": {
                        "get": {
                            "summary": "Details",
                            "description": "Query the API configuration details.",
                            "operationId": "configuration-details",
                            "responses": {
                                "200": {
                                    "description": "200",
                                    "content": {
                                        "application/json": {
                                            "examples": {
                                                "Result": {
                                                    "value": "{\"images\":{\"base_url\":\"http://image.tmdb.org/t/p/\",\"secure_base_url\":\"https://image.tmdb.org/t/p/\",\"backdrop_sizes\":[\"w300\",\"w780\",\"w1280\",\"original\"],\"logo_sizes\":[\"w45\",\"w92\",\"w154\",\"w185\",\"w300\",\"w500\",\"original\"],\"poster_sizes\":[\"w92\",\"w154\",\"w185\",\"w342\",\"w500\",\"w780\",\"original\"],\"profile_sizes\":[\"w45\",\"w185\",\"h632\",\"original\"],\"still_sizes\":[\"w92\",\"w185\",\"w300\",\"original\"]},\"change_keys\":[\"adult\",\"air_date\",\"also_known_as\",\"alternative_titles\",\"biography\",\"birthday\",\"budget\",\"cast\",\"certifications\",\"character_names\",\"created_by\",\"crew\",\"deathday\",\"episode\",\"episode_number\",\"episode_run_time\",\"freebase_id\",\"freebase_mid\",\"general\",\"genres\",\"guest_stars\",\"homepage\",\"images\",\"imdb_id\",\"languages\",\"name\",\"network\",\"origin_country\",\"original_name\",\"original_title\",\"overview\",\"parts\",\"place_of_birth\",\"plot_keywords\",\"production_code\",\"production_companies\",\"production_countries\",\"releases\",\"revenue\",\"runtime\",\"season\",\"season_number\",\"season_regular\",\"spoken_languages\",\"status\",\"tagline\",\"title\",\"translations\",\"tvdb_id\",\"tvrage_id\",\"type\",\"video\",\"videos\"]}"
                                                }
                                            },
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "images": {
                                                        "type": "object",
                                                        "properties": {
                                                            "base_url": {
                                                                "type": "string",
                                                                "example": "http://image.tmdb.org/t/p/"
                                                            },
                                                            "secure_base_url": {
                                                                "type": "string",
                                                                "example": "https://image.tmdb.org/t/p/"
                                                            },
                                                            "backdrop_sizes": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string",
                                                                    "example": "w300"
                                                                }
                                                            },
                                                            "logo_sizes": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string",
                                                                    "example": "w45"
                                                                }
                                                            },
                                                            "poster_sizes": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string",
                                                                    "example": "w92"
                                                                }
                                                            },
                                                            "profile_sizes": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string",
                                                                    "example": "w45"
                                                                }
                                                            },
                                                            "still_sizes": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string",
                                                                    "example": "w92"
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "change_keys": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string",
                                                            "example": "adult"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
