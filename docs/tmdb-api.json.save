lu-Ray\",\"release_date\":\"2009-11-25T00:00:00.000Z\",\"type\":5}]},{\"iso_3166_1\":\"PT\",\"release_dates\":[{\"certification\":\"M/18\",\"descriptors\":[],\"iso_639_1\":\"en\",\"note\":\"\",\"release_date\":\"1999-11-12T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"GB\",\"release_dates\":[{\"certification\":\"18\",\"descriptors\":[],\"iso_639_1\":\"\",\"note\":\"\",\"release_date\":\"1999-11-12T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"MT\",\"release_dates\":[{\"certification\":\"\",\"descriptors\":[],\"iso_639_1\":\"\",\"release_date\":\"1999-11-24T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"JP\",\"release_dates\":[{\"certification\":\"PG12 \",\"descriptors\":[],\"iso_639_1\":\"\",\"note\":\"\",\"release_date\":\"1999-12-11T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"SI\",\"release_dates\":[{\"certification\":\"\",\"descriptors\":[],\"iso_639_1\":\"\",\"release_date\":\"2000-02-24T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"IN\",\"release_dates\":[{\"certification\":\"A\",\"descriptors\":[],\"iso_639_1\":\"en\",\"note\":\"\",\"release_date\":\"1999-10-15T00:00:00.000Z\",\"type\":4}]},{\"iso_3166_1\":\"ID\",\"release_dates\":[{\"certification\":\"\",\"descriptors\":[],\"iso_639_1\":\"\",\"note\":\"\",\"release_date\":\"2021-11-05T00:00:00.000Z\",\"type\":6}]},{\"iso_3166_1\":\"FI\",\"release_dates\":[{\"certification\":\"K-18\",\"descriptors\":[],\"iso_639_1\":\"\",\"note\":\"\",\"release_date\":\"1999-11-12T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"KR\",\"release_dates\":[{\"certification\":\"18\",\"descriptors\":[],\"iso_639_1\":\"\",\"note\":\"\",\"release_date\":\"1999-11-13T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"CZ\",\"release_dates\":[{\"certification\":\"\",\"descriptors\":[],\"iso_639_1\":\"\",\"note\":\"Febio Film Festival\",\"release_date\":\"2000-01-25T00:00:00.000Z\",\"type\":1},{\"certification\":\"\",\"descriptors\":[],\"iso_639_1\":\"\",\"release_date\":\"2000-02-10T00:00:00.000Z\",\"type\":3}]},{\"iso_3166_1\":\"