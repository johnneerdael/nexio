                    "/3/person/{person_id}/tagged_images": {
                        "get": {
                            "summary": "Tagged Images",
                            "description": "Get the tagged images for a person.",
                            "operationId": "person-tagged-images",
                            "parameters": [
                                {
                                    "name": "person_id",
                                    "in": "path",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32"
                                    },
                                    "required": true
                                },
                                {
                                    "name": "page",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32",
                                        "default": 1
                                    }
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "200",
                                    "content": {
                                        "application/json": {
                                            "examples": {
                                                "Result": {
                                                    "value": "{\"id\":31,\"page\":1,\"results\":[{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/1wY4psJ5NVEhCuOYROwLH2XExM2.jpg\",\"height\":1500,\"id\":\"5b235d740e0a265b5d0031d9\",\"iso_639_1\":\"en\",\"vote_average\":5.456,\"vote_count\":7,\"width\":1000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/bdD39MpSVhKjxarTxLSfX6baoMP.jpg\",\"id\":857,\"title\":\"Saving Private Ryan\",\"original_language\":\"en\",\"original_title\":\"Saving Private Ryan\",\"overview\":\"As U.S. troops storm the beaches of Normandy, three brothers lie dead on the battlefield, with a fourth trapped behind enemy lines. Ranger captain John Miller and seven men are tasked with penetrating German-held territory and bringing the boy home.\",\"poster_path\":\"/uqx37cS8cpHg8U35f9U5IBlrCV3.jpg\",\"media_type\":\"movie\",\"genre_ids\":[18,36,10752],\"popularity\":70.45,\"release_date\":\"1998-07-24\",\"video\":false,\"vote_average\":8.208,\"vote_count\":14134},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/23IsAAvjeiScLmK7WIlJTxJKlQO.jpg\",\"height\":2100,\"id\":\"5e3a2b14ac8e6b0011c93b21\",\"iso_639_1\":\"en\",\"vote_average\":5.394,\"vote_count\":10,\"width\":1400,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/cSJMk9Jar8SibFXL8JAF9p2fhKu.jpg\",\"id\":501907,\"title\":\"A Beautiful Day in the Neighborhood\",\"original_language\":\"en\",\"original_title\":\"A Beautiful Day in the Neighborhood\",\"overview\":\"An award-winning cynical journalist, Lloyd Vogel, begrudgingly accepts an assignment to write an Esquire profile piece on the beloved television icon Fred Rogers. After his encounter with Rogers, Vogel's perspective on life is transformed.\",\"poster_path\":\"/p9vCAVhDK375XyobVcKqzqzsUHE.jpg\",\"media_type\":\"movie\",\"genre_ids\":[18,36],\"popularity\":12.688,\"release_date\":\"2019-09-07\",\"video\":false,\"vote_average\":7.008,\"vote_count\":1376},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/gTXR4jM9B4LFSXON92qxJCGTZI1.jpg\",\"height\":3000,\"id\":\"595b7283c3a368253c04b899\",\"iso_639_1\":\"vi\",\"vote_average\":5.384,\"vote_count\":2,\"width\":2000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/hENBbG0J4zf4fFB3OVAC50poojR.jpg\",\"id\":339988,\"title\":\"The Circle\",\"original_language\":\"en\",\"original_title\":\"The Circle\",\"overview\":\"A young tech worker takes a job at a powerful Internet corporation, quickly rises up the company's ranks, and soon finds herself in a perilous situation concerning privacy, surveillance and freedom. She comes to learn that her decisions and actions will determine the future of humanity.\",\"poster_path\":\"/bQVqd5rWrx5GbXhJNuvKy4Viz6j.jpg\",\"media_type\":\"movie\",\"genre_ids\":[18,53,878],\"popularity\":16.99,\"release_date\":\"2017-04-27\",\"video\":false,\"vote_average\":5.505,\"vote_count\":4083},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/arw2vcBveWOVZr6pxd9XTd1TdQa.jpg\",\"height\":1500,\"id\":\"5b0d1773c3a368427f005d0d\",\"iso_639_1\":\"en\",\"vote_average\":5.342,\"vote_count\":15,\"width\":1000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/3h1JZGDhZ8nzxdgvkxha0qBqi05.jpg\",\"id\":13,\"title\":\"Forrest Gump\",\"original_language\":\"en\",\"original_title\":\"Forrest Gump\",\"overview\":\"A man with a low IQ has accomplished great things in his life and been present during significant historic events—in each case, far exceeding what anyone imagined he could do. But despite all he has achieved, his one true love eludes him.\",\"poster_path\":\"/arw2vcBveWOVZr6pxd9XTd1TdQa.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,18,10749],\"popularity\":62.225,\"release_date\":\"1994-06-23\",\"video\":false,\"vote_average\":8.481,\"vote_count\":24535},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6669254658385093,\"file_path\":\"/yiWWUa1mB55dfd0QpGHsFsge67I.jpg\",\"height\":1288,\"id\":\"5d660ffc58361b001021b778\",\"iso_639_1\":\"zh\",\"vote_average\":5.322,\"vote_count\":5,\"width\":859,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/3h1JZGDhZ8nzxdgvkxha0qBqi05.jpg\",\"id\":13,\"title\":\"Forrest Gump\",\"original_language\":\"en\",\"original_title\":\"Forrest Gump\",\"overview\":\"A man with a low IQ has accomplished great things in his life and been present during significant historic events—in each case, far exceeding what anyone imagined he could do. But despite all he has achieved, his one true love eludes him.\",\"poster_path\":\"/arw2vcBveWOVZr6pxd9XTd1TdQa.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,18,10749],\"popularity\":62.225,\"release_date\":\"1994-06-23\",\"video\":false,\"vote_average\":8.481,\"vote_count\":24535},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/dP1KjMbZEBLO76Sg4W5Klyol3jk.jpg\",\"height\":2100,\"id\":\"5eb4c5fdcc277c00216846c2\",\"iso_639_1\":\"en\",\"vote_average\":5.318,\"vote_count\":3,\"width\":1400,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/qZ8t05qidOjhSSsaByxxpu6CKOH.jpg\",\"id\":2565,\"title\":\"Joe Versus the Volcano\",\"original_language\":\"en\",\"original_title\":\"Joe Versus the Volcano\",\"overview\":\"Hypochondriac Joe Banks finds out he has six months to live, quits his dead end job, musters the courage to ask his co-worker out on a date, and is then hired to jump into a volcano by a mysterious visitor.\",\"poster_path\":\"/dP1KjMbZEBLO76Sg4W5Klyol3jk.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,10749],\"popularity\":14.779,\"release_date\":\"1990-03-09\",\"video\":false,\"vote_average\":5.679,\"vote_count\":455},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/rpnzj8vWlodopqNnwOPHQmP5gCI.jpg\",\"height\":1500,\"id\":\"5eb4ccc6ccb15f0021850ef3\",\"iso_639_1\":\"en\",\"vote_average\":5.312,\"vote_count\":1,\"width\":1000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/4XRrEIoRHYfRhX7QnnhLT951T6B.jpg\",\"id\":10466,\"title\":\"The Money Pit\",\"original_language\":\"en\",\"original_title\":\"The Money Pit\",\"overview\":\"After being evicted from their Manhattan apartment, a couple buy what looks like the home of their dreams—only to find themselves saddled with a bank-account-draining nightmare. Struggling to keep their relationship together as their rambling mansion falls to pieces around them, the two watch in hilarious horror as everything—including the kitchen sink—disappears into the Money Pit.\",\"poster_path\":\"/bohhidIi1WWU5NNYF9l5wLQu3Ii.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,10749],\"popularity\":14.443,\"release_date\":\"1986-03-26\",\"video\":false,\"vote_average\":6.496,\"vote_count\":979},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/vrVPAcv2njVdnkqhBwGBc7UxCjz.jpg\",\"height\":1500,\"id\":\"5eb9ab84bbe1dd002186ac59\",\"iso_639_1\":\"en\",\"vote_average\":5.312,\"vote_count\":1,\"width\":1000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/4HJN6dyyPMJTimMglfEdVxjW2p5.jpg\",\"id\":11974,\"title\":\"The 'Burbs\",\"original_language\":\"en\",\"original_title\":\"The 'Burbs\",\"overview\":\"When secretive new neighbors move in next door, suburbanite Ray Peterson and his friends let their paranoia get the best of them as they start to suspect the newcomers of evildoings and commence an investigation. But it's hardly how Ray, who much prefers drinking beer, reading his newspaper and watching a ball game on the tube expected to spend his vacation.\",\"poster_path\":\"/vrVPAcv2njVdnkqhBwGBc7UxCjz.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,27,53],\"popularity\":17.497,\"release_date\":\"1989-02-17\",\"video\":false,\"vote_average\":6.736,\"vote_count\":1038},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/7xpFXAOjgzFPE3vyVerFGfrXhFK.jpg\",\"height\":3000,\"id\":\"5eb2941fbf0f63001d8027ae\",\"iso_639_1\":\"en\",\"vote_average\":5.232,\"vote_count\":17,\"width\":2000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/vtkVKataVJj5i07b9WjlqHq6Dlp.jpg\",\"id\":11287,\"title\":\"A League of Their Own\",\"original_language\":\"en\",\"original_title\":\"A League of Their Own\",\"overview\":\"As America's stock of athletic young men is depleted during World War II, a professional all-female baseball league springs up in the Midwest, funded by publicity-hungry candy maker Walter Harvey. Competitive sisters Dottie Hinson and Kit Keller spar with each other, scout Ernie Capadino and grumpy has-been coach Jimmy Dugan on their way to fame.\",\"poster_path\":\"/nKctKGwUO1PZFupNAdnBU3Q7wgT.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,18],\"popularity\":18.967,\"release_date\":\"1992-07-01\",\"video\":false,\"vote_average\":7.171,\"vote_count\":1191},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/epQDVKTf0tol6LhGGY5iYxpw1ne.jpg\",\"height\":2100,\"id\":\"5ec8b9a9e635710020cf18c4\",\"iso_639_1\":\"en\",\"vote_average\":5.172,\"vote_count\":1,\"width\":1400,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/ioqaIhJSkwa9DGRHGtOOUTiGRs2.jpg\",\"id\":8358,\"title\":\"Cast Away\",\"original_language\":\"en\",\"original_title\":\"Cast Away\",\"overview\":\"Chuck Nolan, a top international manager for FedEx, and Kelly, a Ph.D. student, are in love and heading towards marriage. Then Chuck's plane to Malaysia crashes at sea during a terrible storm. He's the only survivor, and finds himself marooned on a desolate island. With no way to escape, Chuck must find ways to survive in his new home.\",\"poster_path\":\"/6Zp6oj4QxpYFFvrVtb4kGc7r0jK.jpg\",\"media_type\":\"movie\",\"genre_ids\":[12,18],\"popularity\":35.042,\"release_date\":\"2000-12-22\",\"video\":false,\"vote_average\":7.659,\"vote_count\":10201},\"media_type\":\"movie\"},{\"aspect_ratio\":1.777777777777778,\"file_path\":\"/zOfyeSOWa5SPPs82lszeNrMUzH9.jpg\",\"height\":1080,\"id\":\"574e9546c3a3687ff1001ba0\",\"iso_639_1\":null,\"vote_average\":0.0,\"vote_count\":0,\"width\":1920,\"image_type\":\"still\",\"media\":{\"id\":1196876,\"name\":\"Jimmy Fallon \\u0026 Miley Cyrus\",\"overview\":\"Maya Rudolph and Martin Short star with Kenan Thompson and special guests Miley Cyrus, Larry David, Jimmy Fallon and Tom Hanks.\",\"media_type\":\"tv_episode\",\"vote_average\":0.0,\"vote_count\":0,\"air_date\":\"2016-05-31\",\"episode_number\":1,\"production_code\":\"\",\"runtime\":41,\"season_number\":1,\"show_id\":66623,\"still_path\":\"/klKL4vXaFmicRVMcAwGYRVNx78w.jpg\"},\"media_type\":\"episode\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/qJfF5nNa7QF3BsdDbrCepwkCIXs.jpg\",\"height\":1500,\"id\":\"58eabbf09251414b28039d19\",\"iso_639_1\":\"en\",\"vote_average\":0.0,\"vote_count\":0,\"width\":1000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/y3w1fdR3QfYy22ryvhRl6YyHohs.jpg\",\"id\":207932,\"title\":\"Inferno\",\"original_language\":\"en\",\"original_title\":\"Inferno\",\"overview\":\"After waking up in a hospital with amnesia, professor Robert Langdon and a doctor must race against time to foil a deadly global plot.\",\"poster_path\":\"/dtMJQzCxw2AY6tfcxhzlFpiD3BM.jpg\",\"media_type\":\"movie\",\"genre_ids\":[9648,53,18,28],\"popularity\":25.701,\"release_date\":\"2016-10-13\",\"video\":false,\"vote_average\":6.052,\"vote_count\":5770},\"media_type\":\"movie\"},{\"aspect_ratio\":0.6666666666666666,\"file_path\":\"/n8wkXaN5Ox7EvAZqkt0mK7f4aqi.jpg\",\"height\":3000,\"id\":\"5a6722f6c3a3680d0a00a4b5\",\"iso_639_1\":\"pl\",\"vote_average\":0.0,\"vote_count\":0,\"width\":2000,\"image_type\":\"poster\",\"media\":{\"adult\":false,\"backdrop_path\":\"/AbZZz3QwbCrF1hpJfvtl0uZBGGN.jpg\",\"id\":270010,\"title\":\"A Hologram for the King\",\"original_language\":\"en\",\"original_title\":\"A Hologram for the King\",\"overview\":\"Alan Clay, a struggling American businessman, travels to Saudi Arabia to sell a new technology to the King, only to be challenged by endless Middle Eastern bureaucracy, a perpetually absent monarch, and a suspicious growth on his back.\",\"poster_path\":\"/wmjWGb2tqtOA4XPnK1tpIfzRtSQ.jpg\",\"media_type\":\"movie\",\"genre_ids\":[35,18],\"popularity\":12.452,\"release_date\":\"2016-04-22\",\"video\":false,\"vote_average\":5.83,\"vote_count\":1014},\"media_type\":\"movie\"}],\"total_pages\":1,\"total_results\":13}"
                                                }
