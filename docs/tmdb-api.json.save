                    "/3/search/tv": {
                        "get": {
                            "summary": "TV",
                            "description": "Search for TV shows by their original, translated and also known as names.",
                            "operationId": "search-tv",
                            "parameters": [
                                {
                                    "name": "query",
                                    "in": "query",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "name": "first_air_date_year",
                                    "in": "query",
                                    "description": "Search only the first air date. Valid values are: 1000..9999",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32"
                                    }
                                },
                                {
                                    "name": "include_adult",
                                    "in": "query",
                                    "schema": {
