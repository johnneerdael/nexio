                    "/3/movie/{movie_id}/similar": {
                        "get": {
                            "summary": "Similar",
                            "description": "Get the similar movies based on genres and keywords.",
                            "operationId": "movie-similar",
                            "parameters": [
                                {
                                    "name": "movie_id",
                                    "in": "path",
                                    "schema": {
                                        "type": "integer",
