                                        "default": false
                                    }
                                },
                                {
                                    "name": "language",
                                    "in": "query",
                                    "schema": {
                                        "type": "string",
                                        "default": "en-US"
                                    }
                                },
                                {
                                    "name": "page",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32",
                                        "default": 1
                                    }
                                },
                                {
                                    "name": "year",
                                    "in": "query",
                                    "description": "Search the first air date and all episode air dates. Valid values are: 1000..9999",
                                    "schema": {
                                        "type": "integer",
                                        "format": "int32"
                                    }
