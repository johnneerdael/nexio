{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexio.app/schemas/settings-sync.schema.json",
  "title": "NEXIO Account Config Sync Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "integrations", "catalogs", "playback", "formatter"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 7,
      "default": 7
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debrid",
        "theIntroDb",
        "tmdb",
        "tvdb",
        "omdb",
        "imdb",
        "mdblist",
        "animeSkip",
        "subtitleTranslation",
        "posterRatings",
        "traktAuth",
        "simklAuth"
      ],
      "properties": {
        "debrid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["premiumize", "realDebrid", "torBox", "easyDebrid"],
          "properties": {
            "premiumize": {
              "type": "object",
              "additionalProperties": false,
              "required": ["configured", "customerId"],
              "properties": {
                "configured": { "type": "boolean", "default": false },
                "customerId": { "type": ["integer", "null"], "default": null }
              }
            },
            "realDebrid": {
              "type": "object",
              "additionalProperties": false,
              "required": ["connected", "username", "pending", "deviceCode", "userCode", "verificationUrl", "expiresAt"],
              "properties": {
                "connected": { "type": "boolean", "default": false },
                "username": { "type": "string", "default": "" },
                "pending": { "type": "boolean", "default": false },
                "deviceCode": { "type": "string", "default": "" },
                "userCode": { "type": "string", "default": "" },
                "verificationUrl": { "type": "string", "default": "" },
                "expiresAt": { "type": ["integer", "null"], "default": null }
              }
            },
            "torBox": {
              "type": "object",
              "additionalProperties": false,
              "required": ["configured", "email", "plan"],
              "properties": {
                "configured": { "type": "boolean", "default": false },
                "email": { "type": "string", "default": "" },
                "plan": { "type": "string", "default": "" }
              }
            },
            "easyDebrid": {
              "type": "object",
              "additionalProperties": false,
              "required": ["configured", "userId", "paidUntil"],
              "properties": {
                "configured": { "type": "boolean", "default": false },
                "userId": { "type": "string", "default": "" },
                "paidUntil": { "type": "string", "default": "" }
              }
            }
          }
        },
        "theIntroDb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "showIntroButton", "showRecapButton", "showCreditsButton", "showPreviewButton"],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "showIntroButton": { "type": "boolean", "default": true },
            "showRecapButton": { "type": "boolean", "default": true },
            "showCreditsButton": { "type": "boolean", "default": true },
            "showPreviewButton": { "type": "boolean", "default": true }
          }
        },
        "tmdb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "useArtwork", "useBasicInfo", "useDetails", "useCredits", "useProductions", "useNetworks", "useEpisodes", "useMoreLikeThis", "useCollections"],
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "useArtwork": { "type": "boolean", "default": true },
            "useBasicInfo": { "type": "boolean", "default": true },
            "useDetails": { "type": "boolean", "default": true },
            "useCredits": { "type": "boolean", "default": true },
            "useProductions": { "type": "boolean", "default": true },
            "useNetworks": { "type": "boolean", "default": true },
            "useEpisodes": { "type": "boolean", "default": true },
            "useMoreLikeThis": { "type": "boolean", "default": true },
            "useCollections": { "type": "boolean", "default": true }
          }
        },
        "tvdb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "configured", "validationStatus", "lastFailure"],
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "configured": { "type": "boolean", "default": false },
            "validationStatus": {
              "type": "string",
              "enum": ["NOT_CONFIGURED", "VALIDATING", "VALID", "INVALID", "FALLBACK_ACTIVE"],
              "default": "NOT_CONFIGURED"
            },
            "lastFailure": { "type": "string", "default": "" }
          }
        },
        "omdb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          }
        },
        "imdb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "baseUrl"],
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "baseUrl": { "type": "string", "default": "" }
          }
        },
        "mdblist": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "showTrakt",
            "showImdb",
            "showTmdb",
            "showLetterboxd",
            "showTomatoes",
            "showAudience",
            "showMetacritic"
          ],
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "showTrakt": { "type": "boolean", "default": true },
            "showImdb": { "type": "boolean", "default": true },
            "showTmdb": { "type": "boolean", "default": true },
            "showLetterboxd": { "type": "boolean", "default": true },
            "showTomatoes": { "type": "boolean", "default": true },
            "showAudience": { "type": "boolean", "default": true },
            "showMetacritic": { "type": "boolean", "default": true }
          }
        },
        "animeSkip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "clientId"],
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "clientId": { "type": "string", "default": "" }
          }
        },
        "subtitleTranslation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider", "model", "baseUrl"],
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "provider": { "type": "string", "enum": ["OPENAI", "ANTHROPIC", "GEMINI", "DASHSCOPE"], "default": "OPENAI" },
            "model": { "type": "string", "minLength": 1, "default": "openrouter/free" },
            "baseUrl": { "type": "string", "default": "https://openrouter.ai/api/v1" }
          }
        },
        "gemini": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          }
        },
        "posterRatings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rpdbEnabled", "topPostersEnabled"],
          "properties": {
            "rpdbEnabled": { "type": "boolean", "default": false },
            "topPostersEnabled": { "type": "boolean", "default": false }
          }
        },
        "traktAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connected", "username", "userSlug", "connectedAt", "pending"],
          "properties": {
            "connected": { "type": "boolean", "default": false },
            "username": { "type": "string", "default": "" },
            "userSlug": { "type": "string", "default": "" },
            "connectedAt": { "type": ["string", "null"], "default": null },
            "pending": { "type": "boolean", "default": false }
          }
        },
        "simklAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connected", "username", "accountId", "accountType", "pending"],
          "properties": {
            "connected": { "type": "boolean", "default": false },
            "username": { "type": "string", "default": "" },
            "accountId": { "type": ["integer", "null"], "default": null },
            "accountType": { "type": "string", "default": "" },
            "pending": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "trakt", "simkl", "mdblist"],
      "properties": {
        "home": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heroCatalogKeys", "homeCatalogOrderKeys", "disabledHomeCatalogKeys"],
          "properties": {
            "heroCatalogKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "homeCatalogOrderKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "disabledHomeCatalogKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] }
          }
        },
        "trakt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalogEnabledSet", "catalogOrder", "selectedPopularListKeys"],
          "properties": {
            "catalogEnabledSet": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "catalogOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "selectedPopularListKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] }
          }
        },
        "simkl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalogEnabledSet", "catalogOrder"],
          "properties": {
            "catalogEnabledSet": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "catalogOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] }
          }
        },
        "mdblist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hiddenPersonalListKeys", "selectedTopListKeys", "catalogOrder"],
          "properties": {
            "hiddenPersonalListKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "selectedTopListKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
            "catalogOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] }
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streamSelection"],
      "properties": {
        "streamSelection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trackingProvider"],
          "properties": {
            "trackingProvider": {
              "type": "string",
              "default": "TRAKT"
            }
          }
        }
      }
    },
    "formatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "selectedTemplateId", "customTemplate"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "selectedTemplateId": { "type": "string", "default": "universal" },
        "customTemplate": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "nameTemplate", "descriptionTemplate"],
              "properties": {
                "id": { "type": "string", "default": "custom" },
                "label": { "type": "string", "default": "Custom" },
                "nameTemplate": { "type": "string", "default": "" },
                "descriptionTemplate": { "type": "string", "default": "" }
              }
            }
          ],
          "default": null
        }
      }
    }
  }
}
